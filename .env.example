# Copiá este archivo como .env y completá los valores. El .env nunca se commitea.

# --- Base de datos ---
# Usuario, contraseña y nombre de la base que crea el contenedor de PostgreSQL.
# Usá una contraseña sin caracteres especiales (@ : / %), porque va dentro de una URL.
POSTGRES_USER=datos
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=datos

# URL de conexión de SQLAlchemy. Esta sirve para correr la app o Alembic desde la PC
# (fuera de Podman). Dentro de Podman, compose.yaml la arma sola apuntando al servicio "db".
DATABASE_URL=postgresql+psycopg://datos:cambiar-esta-clave@localhost:5432/datos

# --- Seguridad (login, doble factor y sesiones) ---
# Clave para firmar el token CSRF y la cookie temporal del ingreso con Google.
# Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la cambiás, los formularios abiertos dejan de valer (hay que recargar la página).
# También firma los códigos de ingreso que se mandan por email (si cambia, el último código
# mandado deja de valer y hay que pedir otro).
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# true cuando el sitio se sirva por HTTPS (la cookie de sesión lleva "Secure");
# false para http://localhost.
COOKIE_SECURE=false
# El usuario que se registre con este email (o entre con Google con él) queda como administrador.
ADMIN_EMAIL=

# --- Correo saliente (código del doble factor) ---
# Al ingresar se manda un código de 6 dígitos al email del usuario. Se usa Gmail por SMTP
# con una "contraseña de aplicación" (no la contraseña normal de la cuenta):
#   1. En la cuenta de Gmail que va a mandar los correos, activar la verificación en 2 pasos.
#   2. Entrar a https://myaccount.google.com/apppasswords, crear una (por ejemplo "Datos
#      Económicos") y copiar los 16 caracteres que muestra en SMTP_PASSWORD.
# Si SMTP_USER o SMTP_PASSWORD quedan vacíos (desarrollo), no se manda nada: el código se
# escribe en el registro de la app (podman-compose logs app) con un aviso "Correo sin configurar".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente que ve el usuario. Vacío: se usa SMTP_USER.
SMTP_FROM=

# --- Ingreso con Google (opcional) ---
# Si GOOGLE_CLIENT_ID queda vacío, el botón "Continuar con Google" no se muestra.
# Cómo crear las credenciales: ver "Ingreso con Google" en el README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dirección pública de la aplicación, sin barra final. Con ella se arma la URI de
# redirección de Google: BASE_URL + /auth/google/callback.
BASE_URL=http://localhost:8000
